<Page x:Class="Пр12.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page3" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Model" Text="Модель вашей машины:" Grid.Row="0" Grid.Column="0" Margin="100 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock x:Name="ModelCost" Text="Стоимость модели:" Grid.Row="0" Grid.Column="1"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock x:Name="Type" Text="Тип двигателя вашей машины:" Grid.Row="1" Grid.Column="0" Margin="100 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock x:Name="TypeCost" Text="Стоимость двигателя:" Grid.Row="1" Grid.Column="1"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock x:Name="Color" Text="Цвет кузова вашей машины:" Grid.Row="2" Grid.Column="0" Margin="100 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock x:Name="ColorCost" Text="Цена за цвет:" Grid.Row="2" Grid.Column="1"  HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <TextBlock x:Name="Options" Text="Дополнительные опции:" Grid.Row="3" Grid.Column="0" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <TextBlock x:Name="OptionsCost" Text="Стоимость опций:" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,47,0,0"/>

        <TextBlock x:Name="Itog" Text="Итог:" Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Button x:Name="Forward" Content="Далее" Grid.Row="4" Grid.ColumnSpan="2" Height="50" Width="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Forward_Click"/>
        <Button x:Name="Back" Content="Назад" Grid.Row="4" Grid.ColumnSpan="2" Height="50" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Back_Click"/>

    </Grid>
</Page>
