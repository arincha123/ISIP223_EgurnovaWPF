<Page x:Class="Пр12.Pages.AuthRegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthRegPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1"
        Width="400"
        Height="480"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="White"
        BorderBrush="#E0E0E0"
        BorderThickness="1"
        CornerRadius="15">

            <Grid Margin="20 30 20 20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Center">

                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="#FF151286"/>
                            <Setter Property="Padding" Value="20 10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Background="Transparent"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="#FF151286"/>
                                    <Setter Property="BorderThickness" Value="0 0 0 3"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="Foreground" Value="#999999"/>
                                    <Setter Property="BorderThickness" Value="0 0 0 1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Resources>

                    <!--вход-->
                    <TabItem Header="Вход">
                        <StackPanel Margin="0 20 0 0">

                            <!--логин-->
                            <TextBlock Text="Логин"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0 0 0 5"/>

                            <!--ввод логина-->
                            <TextBox x:Name="LoginTextBox"
                             Height="35"
                             FontSize="14"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1"
                             Padding="15 0"
                             VerticalContentAlignment="Center">

                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!--пароль-->
                            <TextBlock Text="Пароль"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               Margin="0 15 0 5"/>

                            <!--ввод пароля-->
                            <PasswordBox x:Name="PasswordBox"
                                 Height="35"
                                 FontSize="14"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 Padding="15,0"
                                 VerticalContentAlignment="Center"/>

                            <!--кнопка для входа-->
                            <Button x:Name="LoginButton"
                            Content="Войти"
                            Height="45"
                            Margin="0,30,0,0"
                            Background="#FF151286"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="LoginButton_Click">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#FF151286"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF2019A0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </TabItem>

                    <!--регистрация-->
                    <TabItem Header="Регистрация">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Height="380">
                            <StackPanel Margin="0,20,0,20">

                                <!--имя пользователя-->
                                <TextBlock Text="Имя"
                                   FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#333333"
                                    Margin="0,0,0,5"/>

                                <!--ввод имени-->
                                <TextBox x:Name="RegNameTextBox"
                                 Height="35"
                                 FontSize="14"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 Padding="15,0"
                                 VerticalContentAlignment="Center"/>

                                <!--логин-->
                                <TextBlock Text="Логин"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,15,0,5"/>

                                <!--ввод логина-->
                                <TextBox x:Name="RegLoginTextBox"
                                     Height="35"
                                     FontSize="14"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1"
                                     Padding="15,0"
                                     VerticalContentAlignment="Center"/>

                                <!-- эмейл -->
                                <TextBlock Text="Email"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,15,0,5"/>

                                <!--ввод эмейла-->
                                <TextBox x:Name="RegEmailTextBox"
                                     Height="35"
                                     FontSize="14"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1"
                                     Padding="15,0"
                                     VerticalContentAlignment="Center"/>

                                <!--пароль-->
                                <TextBlock Text="Пароль"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,15,0,5"/>

                                <!--ввод пароля-->
                                <PasswordBox x:Name="RegPasswordBox"
                                     Height="35"
                                     FontSize="14"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1"
                                     Padding="15,0"
                                     VerticalContentAlignment="Center"/>

                                <!--подтверждение пароля-->
                                <TextBlock Text="Подтвердите пароль"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,15,0,5"/>

                                <!--второй раз ввод пароля-->
                                <PasswordBox x:Name="RegConfirmPasswordBox"
                                     Height="35"
                                     FontSize="14"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1"
                                     Padding="15,0"
                                     VerticalContentAlignment="Center"/>

                                <!--кнопка регистрации-->
                                <Button x:Name="RegisterButton"
                                Content="Зарегистрироваться"
                                Height="45"
                                Margin="0,30,0,20"
                                Background="#FF151286"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="RegisterButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#FF151286"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF2019A0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Page>
