<Page x:Class="Пр12.Pages.AllTovari"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="400"
      Title="AllTovari">

    <Grid>
        <ListBox x:Name="Tovars" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.RowSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel Width="150" Height="170">
                        <StackPanel>
                            <Image Source="{Binding IMAGE_TOVAR}" Width="150" Height="100"/>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding NAME_TOVAR, StringFormat=Название: {0}}"/>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding PRICE_TOVAR, StringFormat=Цена: {0}}"/>
                            <Button x:Name="InCart" Content="В корзину" HorizontalAlignment="Center" Click="InCart_Click"/>
                        </StackPanel>
                    </WrapPanel>

                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Button x:Name="cart" Content="Корзина" Width="100" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0 10 20 10" Click="cart_Click" />

    </Grid>
</Page>
