<Page x:Class="Пр12.Pages.SessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SessionPage">

    <Page.Resources>
        <local:ColorConvert x:Key="ColorConverts"/>
    </Page.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <TextBlock Text="Выбор места в кинозале" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                <ListBox x:Name="SeatGrid" HorizontalAlignment="Center" Margin="0 0 0 30" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Width="250" ItemsSource="{Binding sEATs}" d:ItemsSource="{d:SampleData ItemCount=6}" SelectionChanged="SeatGrid_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel></WrapPanel>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <WrapPanel Orientation="Horizontal">
                                <Border Width="30" Height="30"  Background="{Binding ID_SEAT, Converter={StaticResource ColorConverts}}">
                                    <TextBlock Text="{Binding NUMBER}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </WrapPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" >
            <Button x:Name="OrderTicket" Content="Оформить билет" Background="{x:Null}" Click="OrderTicket_Click" />

        </WrapPanel>



        <Button x:Name="Back" Content="Назад" Grid.Row="1" Width="100" Height="33" HorizontalAlignment="Left" Margin="20 0 0 0" Click="Back_Click"/>



    </Grid>
</Page>
