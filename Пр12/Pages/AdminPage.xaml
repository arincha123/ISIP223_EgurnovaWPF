<Page x:Class="Пр12.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage" Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1"
                    Style="{StaticResource TabControlForBooks}"
                    Margin="0,10,0,0">


            <TabItem Header="Жалобы" 
                     Width="120">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Список жалоб"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF151286"
                               Margin="0,0,0,5"/>

                    <ListBox x:Name="ComplaintsListBox"
                             Grid.Row="1"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0" Padding="10" Margin="0,5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding User.Name, StringFormat='Пользователь: {0}'}"
                                                   FontWeight="Bold"
                                                   FontSize="14"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{Binding Reason.Reason, StringFormat='Причина: {0}'}"
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   Margin="0,5,0,5"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}"
                                                   FontSize="11"
                                                   Foreground="Gray"/>

                                        <WrapPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="3">
                                            <Button Content="Принять"
                                                    Style="{StaticResource ActionBtn}"
                                                    Width="80"
                                                    Height="30"
                                                    Margin="0,0,5,0"
                                                    Click="AcceptComplaint_Click"/>
                                            
                                            <Button Content="Отклонить"
                                                    Style="{StaticResource BtnBack}"
                                                    Width="80"
                                                    Height="30"
                                                    Click="RejectComplaint_Click"/>
                                            
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Заявки на разморозку"
                     Width="200">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Список заявок на разморозку"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF151286"
                               Margin="0,0,0,15"/>

                    <ListBox x:Name="DefrostRequestsListBox"
                             Grid.Row="1"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10" Margin="0,5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding User.Name, StringFormat='Пользователь: {0}'}"
                                                   FontWeight="Bold"
                                                   FontSize="14"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{Binding Type.Type, StringFormat='Тип: {0}'}"
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   Margin="0,5,0,5"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="{Binding Reason, StringFormat='Причина: {0}'}"
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   Margin="0,5,0,5"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}"
                                                   FontSize="11"
                                                   Foreground="Gray"/>

                                        <WrapPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="4">
                                            <Button Content="Принять"
                                                    Style="{StaticResource ActionBtn}"
                                                    Width="80"
                                                    Height="30"
                                                    Margin="0,0,5,0"
                                                    Click="AcceptDefrostRequest_Click"/>
                                            
                                            <Button Content="Отклонить"
                                                    Style="{StaticResource BtnBack}"
                                                    Width="80"
                                                    Height="30"
                                                    Click="RejectDefrostRequest_Click"
                                                    Tag="{Binding}"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Заявки на роль автора"
                     Width="210">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Список заявок на роль автора"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF151286"
                               Margin="0,0,0,15"/>

                    <ListBox x:Name="AuthorRequestsListBox"
                             Grid.Row="1"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding User.Name, StringFormat='Пользователь: {0}'}"
                                                       FontWeight="Bold"
                                                       FontSize="14"/>
                                            
                                            <TextBlock Text="{Binding Date, StringFormat='Дата подачи: {0:dd.MM.yyyy}'}"
                                                       FontSize="12"
                                                       Foreground="Gray"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <WrapPanel Grid.Column="1">
                                            <Button Content="Принять"
                                                    Style="{StaticResource ActionBtn}"
                                                    Width="80"
                                                    Height="30"
                                                    Margin="0,0,5,0"
                                                    Click="AcceptAuthorRequest_Click"/>
                                            
                                            <Button Content="Отклонить"
                                                    Style="{StaticResource BtnBack}"
                                                    Width="80"
                                                    Height="30"
                                                    Click="RejectAuthorRequest_Click"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Замороженные"
                     Width="170">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Замороженные книги, пользователи, отзывы"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF151286"
                               Margin="0,0,0,15"/>

                    <TabControl Grid.Row="1" Margin="0,0,0,15">
                        <TabItem Header="Книги">
                            <ListBox x:Name="FrozenBooksListBox"
                                     Height="200"
                                     Margin="0,10,0,0"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="5" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" 
                                                        Content="Разморозить"
                                                        Style="{StaticResource ActionBtn}"
                                                        Width="100"
                                                        Height="25"
                                                        Click="UnfreezeBook_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Пользователи">
                            <ListBox x:Name="FrozenUsersListBox"
                                     Height="200"
                                     Margin="0,10,0,0"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="5" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" 
                                                        Content="Разморозить"
                                                        Style="{StaticResource ActionBtn}"
                                                        Width="100"
                                                        Height="25"
                                                        Click="UnfreezeUser_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Отзывы">
                            <ListBox x:Name="FrozenReviewsListBox"
                                     Height="200"
                                     Margin="0,10,0,0"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="5" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Text}" 
                                                           VerticalAlignment="Center"
                                                           MaxWidth="300"
                                                           TextTrimming="WordEllipsis"/>
                                                <Button Grid.Column="1" 
                                                        Content="Разморозить"
                                                        Style="{StaticResource ActionBtn}"
                                                        Width="100"
                                                        Height="25"
                                                        Click="UnfreezeReview_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Пользователи"
                     Width="170">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Список пользователей"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF151286"
                               Margin="0,0,0,15"/>


                    <ListBox x:Name="UsersListBox"
                             Grid.Row="2"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10" Margin="0,5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding Name, StringFormat='Имя: {0}'}"
                                                   FontWeight="Bold"
                                                   FontSize="14"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{Binding Login, StringFormat='Логин: {0}'}"
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   Margin="0,5,0,5"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="{Binding Email, StringFormat='Email: {0}'}"
                                                   FontSize="12"
                                                   Foreground="Gray"/>

                                        <WrapPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="3">
                                            <ComboBox x:Name="RoleComboBox"
                                                      Style="{StaticResource ComboForBooks}"
                                                      Width="120"
                                                      Height="30"
                                                      Margin="0,0,5,0"
                                                      SelectedValue="{Binding RoleID}"
                                                      SelectionChanged="RoleComboBox_SelectionChanged"
                                                      Tag="{Binding}">
                                                <ComboBoxItem Content="Читатель" Tag="1"/>
                                                <ComboBoxItem Content="Автор" Tag="2"/>
                                                <ComboBoxItem Content="Администратор" Tag="3"/>
                                            </ComboBox>
                                            <Button Content="Сменить пароль"
                                                    Style="{StaticResource ActionBtn}"
                                                    Background="#FFE8FFFC"
                                                    Foreground="Black"
                                                    Width="120"
                                                    Height="30"
                                                    Margin="0,0,5,0"
                                                    Click="ChangePassword_Click"/>
                                            
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
