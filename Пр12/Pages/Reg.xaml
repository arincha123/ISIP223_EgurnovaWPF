<Page x:Class="Пр12.Pages.Reg"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Reg">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Введите свой логин" Width="300" />
            <TextBox x:Name="Login" Margin="0 10 0 0" SelectionChanged="Dannie_SelectionChanged"/>
            <TextBlock Text="Введите свой пароль" Width="300" Margin="0 10 0 0"/>
            <TextBox x:Name="Password" Margin="0 10 0 0" TextChanged="Dannie_SelectionChanged"/>
            <Button x:Name="RegIn" Content="Зарегистрироваться" Width="150" Height="20" Margin="0 30 0 0" Click="RegIn_Click" IsEnabled="False"/>
        </StackPanel>

        <Button Content="Назад" Width="100" Height="30" Background="{x:Null}" BorderBrush="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" Click="Button_Click_1"/>
    </Grid>
</Page>
