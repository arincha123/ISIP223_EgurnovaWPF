<Page x:Class="Пр12.Pages.YourTickets"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="YourTickets">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" />

        <ListBox Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding SESSIONS.FILM.NAME_FILM, StringFormat= Название фильма: {0}}"/>
                        <TextBlock Text="{Binding SESSIONS.DATE_SESSION, StringFormat= Дата сеанса: {0:dd.MM}}"/>
                        <TextBlock Text="{Binding SESSIONS.DATE_SESSION, StringFormat= Время сеанса: {0:hh:mm}}"/>
                        <TextBlock Text="{Binding SESSIONS., StringFormat= Время сеанса: {0:hh:mm}}"/>
                        <TextBlock Text="{Binding SESSIONS.DATE_SESSION, StringFormat= Место: {0:}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

        </ListBox>

    </Grid>
</Page>
