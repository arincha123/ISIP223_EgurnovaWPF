<Page x:Class="Пр12.Pages.BookInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookInfo">

    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--левая колонка с картинкой и кнопками-->
            <StackPanel Grid.Column="0">
                
                <!--кнопка назад-->
                <Button x:Name="Btn_Back"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Style="{StaticResource BtnBack}"
                    Margin="10"
                    Content="← Назад" 
                    Click="Btn_Back_Click"/>

                <!--обложка-->
                <Image Source="{Binding CurrentBook.PathToCover}"
                   Stretch="Uniform"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   Margin="20 0 20 0"
                   MaxHeight="3200"
                   MinHeight="200">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Height" Value="Auto"/>
                            <Setter Property="Width" Value="Auto"/>
                        </Style>
                    </Image.Style>
                </Image>

                <!--кнопка для чтения фрагмента текста-->
                <Button x:Name="Readpart"
                    Style="{StaticResource ActionBtn}"
                    Content="Читать фрагмент"
                    Width="180"
                    Margin="20 10 0 0"/>

                <!--кнопка для добавления в список-->
                <Button x:Name="AddInList"
                    Style="{StaticResource ActionBtn}"
                    Content="Добавить в список"
                    Width="180"
                    Margin="20 10 0 10"/>

                <!--кнопка для заморозки книги (для админа)-->
                <Button x:Name="FreezeBook"
                    Style="{StaticResource ActionBtn}"
                    Content="Заморозить книгу"
                    Width="180"
                    Margin="20 0 0 20"/>

            </StackPanel>

            <!--правая колонка с описанием книги-->
            <StackPanel Grid.Column="1">
                
                <!--название книги-->
                <TextBlock Text="{Binding DataContext.CurrentBook.Title}"  
                       FontSize="26" 
                       FontWeight="Bold" 
                       Margin="30 50 0 10" />

                <!--имя автора-->
                <TextBlock Text="{Binding DataContext.CurrentBook.User.Name, StringFormat='Автор: {0}'}"
                        FontSize="20"  
                        Margin="30 0 0 0" />
              
                <!--рамка для рейтинка и колтчества отзывов-->
                <Border BorderThickness="1.5" 
                    BorderBrush="#FF151286"
                    CornerRadius="10"
                    Margin="30 10 0 0"
                    Width="auto"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Padding="10">
                    
                    <WrapPanel>

                        <TextBlock Text="{Binding DataContext.CurrentBook.AvgRating, StringFormat='{}{0}★'}"
                               FontSize="20"  
                               Margin="0 0 0 0" 
                               FontWeight="Bold"/>

                    </WrapPanel>
                </Border>

                <!-- текст жанры -->
                <TextBlock Text="Жанры"
                       FontSize="20"  
                       FontWeight="Bold"
                       Margin="30 10 0 0"/>
                
                <!--список жанров-->
                <ItemsControl ItemsSource="{Binding CurrentBook.BookInGenre}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="30 0 0 0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            
                            <Border 
                                Background="#FFE8FFFC"
                                CornerRadius="5"
                                Padding="10,5"
                                Margin="0,5,10,5">
                                
                                <TextBlock Text="{Binding Genre.Name}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#FF151286"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- текст описание -->
                <TextBlock Text="Описание"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="30 10 0 0"/>

                <!--описание книги-->
                <TextBlock Text="{Binding DataContext.CurrentBook.Description}"
                       TextWrapping="Wrap"
                       FontSize="18"
                       Margin="30 0 30 10"/>

                <!--блок жалоб-->
                <WrapPanel>
                    
                        <!-- кнопка жалобы на автора -->
                    <Button x:Name="ComplainAuthorBtn"
                                Style="{StaticResource BtnBack}"
                                Content="Пожаловаться на автора"
                                Width="200"
                                Background="Transparent"
                                BorderThickness="0"
                                BorderBrush="{x:Null}"
                                VerticalAlignment="Center"
                                Margin="10 0 0 0"/>

                    <!--кнопка жалобы на книгу-->
                    <Button x:Name="ComplainBookBtn"
                            Style="{StaticResource BtnBack}"
                            Content="Пожаловаться на автора"
                            Width="200"
                            Background="Transparent"
                            BorderThickness="0"
                            BorderBrush="{x:Null}"
                            VerticalAlignment="Center"
                            Margin="10 0 0 0"/>

                </WrapPanel>
                
                <!-- текст отзывы -->
                <TextBlock Text="Отзывы"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="30 20 0 10"/>

                <!-- сам список отзывов -->
                <ListBox x:Name="ReviewsListBox"
                         Style="{StaticResource ListReviews}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Margin="30 0 30 0">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="{Binding User.Name}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding Rating, StringFormat='Оценка: {0}★'}"
                                                   FontSize="14"
                                                   Foreground="#FF151286"/>

                                        <TextBlock Text="{Binding Date, StringFormat=' - {0:dd.MM.yyyy HH:mm}'}"
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   Margin="10,0,0,0"/>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- cообщение, если отзывов нет -->
                <TextBlock x:Name="NoReviewsText"
                           Text="Пока нет отзывов. Будьте первым!"
                           FontSize="16"
                           Foreground="Gray"
                           Margin="30,10,0,20"
                           Visibility="Collapsed"/>

                <!-- форма добавления отзыва -->
                <Border BorderBrush="#FF151286"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="30 0 30 20"
                        Padding="15">
                    <StackPanel>
                        
                        <TextBlock Text="Оставить отзыв"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <!-- выбор оценки -->
                        <WrapPanel Margin="0,0,0,10">
                            
                            <TextBlock Text="Оценка:"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            
                            <ComboBox x:Name="RatingComboBox"
                                      Style="{StaticResource ComboForBooks}"
                                      Height="30"
                                      BorderBrush="{x:Null}"
                                      BorderThickness="0"
                                      Width="70"
                                      SelectedIndex="0"
                                      Cursor="Hand">
                                
                                <ComboBoxItem Content="5 ★"/>
                                <ComboBoxItem Content="4 ★"/>
                                <ComboBoxItem Content="3 ★"/>
                                <ComboBoxItem Content="2 ★"/>
                                <ComboBoxItem Content="1 ★"/>
                            </ComboBox>

                        </WrapPanel>

                        <!-- поле для ввода текста отзыва -->
                        <TextBox x:Name="CommentTextBox"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,10"/>

                        <!-- кнопка отправки отзыва -->
                        <Button x:Name="SubmitReviewButton"
                                Style="{StaticResource ActionBtn}"
                                Content="Оставить отзыв"
                                Width="150"
                                HorizontalAlignment="Right"
                                Click="SubmitReviewButton_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>

</Page>
