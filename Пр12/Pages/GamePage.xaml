<Page x:Class="Пр12.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GamePage">

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#FF137D26" BorderThickness="5" CornerRadius="10" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Этаж" Grid.Row="0" Grid.Column="0" Margin="10 0 0 0" FontSize="18" VerticalAlignment="Center" Foreground="White" />
                <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Здоровье"  FontSize="18" VerticalAlignment="Center" Foreground="White"/>
                    <ProgressBar x:Name="Hp" Width="250" Margin="20 0 0 0" Foreground="#FF137D26"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border>
            
        </Border>
        



    </Grid>
</Page>
