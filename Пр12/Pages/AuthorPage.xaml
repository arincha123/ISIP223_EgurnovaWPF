<Page x:Class="Пр12.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorPage" Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1"
                    Style="{StaticResource TabControlForBooks}"
                    Margin="0,10,0,0">

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="15,10"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Мои книги">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="AddBookBtn"
                            Content="+ Добавить новую книгу"
                            Width="200"
                            Height="40"
                            HorizontalAlignment="Right"
                            Background="#FF151286"
                            Foreground="White"
                            Cursor="Hand"
                            Margin="0,0,0,15"
                            Click="AddBookBtn_Click"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="MyOwnBooks">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="220" 
                                            Height="450"
                                            Background="White"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10">
                                        <StackPanel>
                                            <Image Source="{Binding PathToCover}" 
                                                   Height="290"
                                                   Stretch="UniformToFill"/>

                                            <TextBlock Text="{Binding Title}" 
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"
                                                       Margin="0 8 0 0"/>

                                            <TextBlock Text="{Binding User.Name, StringFormat='Автор: {0}'}" 
                                                       FontSize="12"
                                                       Foreground="Gray"
                                                       Margin="0 5 0 0"/>

                                            <TextBlock Text="{Binding AvgRating, StringFormat='★ {0:F1}'}"
                                                       FontSize="12"
                                                       Foreground="#FF151286"
                                                       Margin="0 5 0 0"/>

                                            <WrapPanel VerticalAlignment="Bottom">
                                                <Button Content="Редактировать"
                                                        HorizontalAlignment="Center"
                                                        Width="90"
                                                        Height="30"
                                                        Background="#FF151286"
                                                        Foreground="White"
                                                        FontSize="11"
                                                        Cursor="Hand"
                                                        Click="EditBookBtn_Click"/>

                                                <Button Content="Удалить"
                                                        Style="{StaticResource BtnBack}"
                                                        Width="90"
                                                        Height="30"
                                                        Background="#FF151286"
                                                        Foreground="White"
                                                        FontSize="11"
                                                        Margin="15 0 0 0 "
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="DelBookBtn_Click"/>
                                            </WrapPanel>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <TextBlock x:Name="NoBooksText"
                               Grid.Row="1"
                               Text="У вас пока нет опубликованных книг. Нажмите '+ Добавить новую книгу' чтобы создать первую книгу."
                               FontSize="14"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </TabItem>

            <TabItem Header="Замороженные книги">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Книги, которые были заморожены администратором"
                               FontSize="14"
                               Foreground="Gray"
                               Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FrozenBooksItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="220" 
                                            Height="450" 
                                            Margin="10"
                                            Background="#FFF5F5F5"
                                            BorderBrush="#FFCCCC"
                                            BorderThickness="2"
                                            CornerRadius="10"
                                            Padding="10">
                                        <StackPanel>
                                            <Image Source="{Binding PathToCover}" 
                                                   Height="290"
                                                   Stretch="UniformToFill"
                                                   Opacity="0.6"/>

                                            <TextBlock Text="{Binding Title}" 
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>

                                            <TextBlock Text="{Binding User.Name, StringFormat='Автор: {0}'}" 
                                                       FontSize="12"
                                                       Foreground="Gray"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Text="ЗАМОРОЖЕНА"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#FF0000"
                                                       Background="#FFEEEE"
                                                       Padding="5,2"
                                                       TextAlignment="Center"
                                                       Margin="0,10,0,0"/>

                                            <Button Content="Оспорить заморозку"
                                                    Width="180"
                                                    Height="35"
                                                    Margin="0,15,0,0"
                                                    Background="#FF151286"
                                                    Foreground="White"
                                                    Cursor="Hand"
                                                    FontSize="12"
                                                    Click="AppealFreezeBookBtn_Click"
                                                    Tag="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="NoFrozenBooksText"
                               Grid.Row="1"
                               Text="Нет замороженных книг"
                               FontSize="14"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
