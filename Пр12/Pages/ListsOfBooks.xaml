<Page x:Class="Пр12.Pages.ListOfBooks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListOfBooks" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" 
                Grid.Column="0"  
                Margin="10,15,10,15"  
                VerticalAlignment="Center"  
                Height="45" 
                BorderBrush="#FF151286"
                BorderThickness="1.5" 
                CornerRadius="23" 
                Background="White">

            <Grid>
                <!--картинка лупы-->
                <TextBlock Text="🔍" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left"
                           Margin="15,0,0,0"  
                           FontSize="16" 
                           Foreground="#999999"/>

                <!--сам поиск-->
                <TextBox x:Name="SearchBox" 
                         Height="45"
                         VerticalAlignment="Center" 
                         VerticalContentAlignment="Center" 
                         Padding="40,0,15,0"
                         BorderThickness="0" 
                         Background="Transparent" 
                         FontSize="14" 
                         Foreground="#333333"
                         CaretBrush="#FF151286" 
                         ToolTipService.IsEnabled="False" 
                         TextChanged="SearchBox_TextChanged"/>

                <!--водяной знак в поиске-->
                <TextBlock IsHitTestVisible="False" 
                            Text="Найти..." 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Left" 
                            Margin="40,0,0,0" 
                            Foreground="#AAAAAA" 
                            FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!--сортировка по названию и оценке-->
        <ComboBox x:Name="ComboSort"
                  Grid.Row="0" Grid.Column="1" 
                  Margin="5,15,5,15" Width="140" Height="45" Padding="15,0,10,0"
                  BorderThickness="0" FontSize="13" 
                  VerticalAlignment="Center"
                  Tag="Сортировать по"
                  RenderOptions.EdgeMode="Aliased"
                  Style="{StaticResource ComboForBooks}" SelectionChanged="ComboSort_SelectionChanged">
            <ComboBoxItem Content="Все"/>
            <ComboBoxItem Content="По названию"/>
            <ComboBoxItem Content="По рейтингу"/>
        </ComboBox>

        <!--фильтрация по жанрам-->
        <ComboBox x:Name="ComboFiltr"
                  Grid.Row="0" Grid.Column="2" 
                  Margin="5,15,5,15" Width="140" Height="45" Padding="15,0,10,0"
                  BorderThickness="0" FontSize="13" 
                  VerticalAlignment="Center"
                  Tag="Выберите жанр"
                  RenderOptions.EdgeMode="Aliased"
                  Style="{StaticResource ComboForBooks}" SelectionChanged="ComboFiltr_SelectionChanged">
        </ComboBox>

        <!--TabControl для списков-->
        <TabControl x:Name="MainTabControl"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Margin="10"
                    Background="White"
                    BorderThickness="0">

            <!--заброшенки-->
            <TabItem x:Name="AbandonedTab" 
                     Header="Заброшено" 
                     MouseDoubleClick="ListBox_MouseDoubleClick">
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    
                    <ListBox x:Name="AbandonedListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             MouseDoubleClick="ListBox_MouseDoubleClick" d:ItemsSource="{d:SampleData ItemCount=5}">
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200" 
                                        Height="360" 
                                         Margin="10"
                                         Background="White"
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="1"
                                         CornerRadius="5 5 0 0 ">

                                    <StackPanel>

                                        <Image Source="{Binding Book.PathToCover}" 
                                                Height="230"
                                                Width="200"/>

                                        <TextBlock Text="{Binding Book.Title}" 
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding Book.User.Name}" 
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding Book.AvgRating, StringFormat='★ {0}'}"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>

                                        <ComboBox x:Name="MoveToListCombo"
                                                  Style="{StaticResource ComboForBooks}"
                                                  SelectedValue="{Binding ListStatusID}"
                                                  SelectionChanged="MoveToList_SelectionChanged"
                                                  Tag="{Binding}"
                                                  Margin="0,10,0,0"
                                                  Height="30">
                                            
                                            <ComboBoxItem Content="В планах" Tag="2"/>
                                            <ComboBoxItem Content="Читаю" Tag="3"/>
                                            <ComboBoxItem Content="Прочитано" Tag="4"/>
                                            <ComboBoxItem Content="Заброшено" Tag="1" IsSelected="True"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </TabItem>

            <!--в планах-->
            <TabItem x:Name="PlansTab" 
                     Header="В планах" 
                     MouseDoubleClick="ListBox_MouseDoubleClick" >
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="PlansListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             MouseDoubleClick="ListBox_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Width="200" 
                                        Height="360" 
                                         Margin="10"
                                         Background="White"
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="1"
                                         CornerRadius="5 5 0 0 ">

                                    <StackPanel>

                                        <Image Source="{Binding Book.PathToCover}" 
                                                Height="230"
                                                Width="200"/>

                                        <TextBlock Text="{Binding Book.Title}" 
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding Book.User.Name}" 
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding Book.AvgRating, StringFormat='★ {0}'}"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>

                                        <ComboBox x:Name="MoveToListCombo"
                                                  Style="{StaticResource ComboForBooks}"
                                                  SelectionChanged="MoveToList_SelectionChanged"
                                                  Tag="{Binding}"
                                                  Margin="0,10,0,0"
                                                  Height="30">
                                            <ComboBoxItem Content="В планах" Tag="2" IsSelected="True"/>
                                            <ComboBoxItem Content="Читаю" Tag="3"/>
                                            <ComboBoxItem Content="Прочитано" Tag="4"/>
                                            <ComboBoxItem Content="Заброшено" Tag="1"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </TabItem>

            <!--читаю-->
            <TabItem x:Name="ReadingTab" 
                     Header="Читаю" 
                     MouseDoubleClick="ListBox_MouseDoubleClick" >
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    
                    <ListBox x:Name="ReadingListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             MouseDoubleClick="ListBox_MouseDoubleClick">
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Width="200" 
                                        Height="360" 
                                        Margin="10"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="5 5 0 0 ">

                                    <StackPanel>

                                        <Image Source="{Binding Book.PathToCover}" 
                                           Height="230"
                                           Width="200"/>

                                        <TextBlock Text="{Binding Book.Title}" 
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding Book.User.Name}" 
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding Book.AvgRating, StringFormat='★ {0}'}"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>

                                        <ComboBox x:Name="MoveToListCombo"
                                                  Style="{StaticResource ComboForBooks}"
                                                  SelectionChanged="MoveToList_SelectionChanged"
                                                  Tag="{Binding}"
                                                  Margin="0,10,0,0"
                                                  Height="30">
                                            <ComboBoxItem Content="В планах" Tag="2"/>
                                            <ComboBoxItem Content="Читаю" Tag="3" IsSelected="True"/>
                                            <ComboBoxItem Content="Прочитано" Tag="4"/>
                                            <ComboBoxItem Content="Заброшено" Tag="1"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </TabItem>

            <!--прочитано-->
            <TabItem x:Name="ReadTab" Header="Прочитано" MouseDoubleClick="ListBox_MouseDoubleClick" >
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    
                    <ListBox x:Name="ReadListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             MouseDoubleClick="ListBox_MouseDoubleClick">
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Width="200" 
                                        Height="360"
                                         Margin="10"
                                         Background="White"
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="1"
                                         CornerRadius="5 5 0 0 ">

                                    <StackPanel>

                                        <Image Source="{Binding Book.PathToCover}" 
                                                Height="230"
                                                Width="200"/>

                                        <TextBlock Text="{Binding Book.Title}" 
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding Book.User.Name}" 
                                                   FontSize="12"
                                                   Foreground="Gray"
                                                   HorizontalAlignment="Center"/>
                                        
                                        <TextBlock Text="{Binding Book.AvgRating, StringFormat='★ {0}'}"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>

                                        <ComboBox x:Name="MoveToListCombo"
                                                  Style="{StaticResource ComboForBooks}"
                                                  SelectionChanged="MoveToList_SelectionChanged"
                                                  Tag="{Binding}"
                                                  Margin="0,10,0,0"
                                                  Height="30">
                                            <ComboBoxItem Content="В планах" Tag="2"/>
                                            <ComboBoxItem Content="Читаю" Tag="3"/>
                                            <ComboBoxItem Content="Прочитано" Tag="4" IsSelected="True"/>
                                            <ComboBoxItem Content="Заброшено" Tag="1"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
