<Page x:Class="Пр12.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>

        <TabControl x:Name="MainTabControl" TabStripPlacement="Left">
            <TabItem x:Name="TCatalog" ToolTip="Каталог книг" Style="{StaticResource SlidebarItem}">
                <TabItem.Header>
                    <Image Source="/Icons/каталог_книг.png" Height="60" Width="60"/>
                </TabItem.Header>
                <Frame NavigationUIVisibility="Hidden" x:Name="frameCatalog" Source="/Pages/CatalogPage.xaml" Margin="10 0 0 0"/>
            </TabItem>

            <TabItem x:Name="TLists" ToolTip="Списки книг" Style="{StaticResource SlidebarItem}">
                <TabItem.Header>
                    <Image Source="/Icons/списки_книг.png" Height="60" Width="60"/>
                </TabItem.Header>
                <Frame NavigationUIVisibility="Hidden" x:Name="frameListBook" Source="/Pages/ListsOfBooks.xaml" Margin="10 0 0 0"/>
            </TabItem>

            <TabItem x:Name="TAdmin" ToolTip="Администрирование" Style="{StaticResource SlidebarItem}">
                <TabItem.Header>
                    <Image Source="/Icons/администрирование.png" Height="60" Width="60"/>
                </TabItem.Header>
                <Frame  NavigationUIVisibility="Hidden" x:Name="frameAdmin" Source="/Pages/AdminPage.xaml" Margin="10 0 0 0"/>

            </TabItem>

            <TabItem x:Name="TAuthor" ToolTip="Страница автора" Style="{StaticResource SlidebarItem}">
                <TabItem.Header>
                    <Image Source="/Icons/страница_автора.png" Height="60" Width="60"/>
                </TabItem.Header>
                <Frame NavigationUIVisibility="Hidden" x:Name="frameAuthor" Source="/Pages/AuthorPage.xaml" Margin="10 0 0 0"/>
            </TabItem>

            <TabItem x:Name="TFreeze" ToolTip="Предупреждение о заморозке" Style="{StaticResource SlidebarItem}">
                <TabItem.Header>
                    <Image Source="/Icons/заморозка.png" Height="60" Width="60"/>
                </TabItem.Header>
                <Frame NavigationUIVisibility="Hidden" x:Name="frameFroze" Source="/Pages/FrozePage.xaml" Margin="10 0 0 0"/>
            </TabItem>

            <TabItem x:Name="TProfile" ToolTip="Профиль" Style="{StaticResource SlidebarItem}">
                <TabItem.Header>
                    <Image Source="/Icons/профиль.png" Height="60" Width="60"/>
                </TabItem.Header>
                <Frame  NavigationUIVisibility="Hidden" x:Name="frameProfile" Source="/Pages/ProfilePage.xaml" Margin="10 0 0 0"/>
            </TabItem>
        </TabControl>

        <Button x:Name="LogoutBtn"
                Content="Выход"
                Width="80"
                Height="40"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10,0,10,20"
                Style="{StaticResource BtnBack}"
                FontSize="14"
                FontWeight="SemiBold"
                Panel.ZIndex="1000"
                Click="LogoutBtn_Click"/>

        <Frame x:Name="AuthFrame" 
               NavigationUIVisibility="Hidden"/>
        
    </Grid>
</Page>
