<Page x:Class="Пр12.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Page.Resources>
        <local:AgeRatingConverter x:Key="MyAgeRatingConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" >
            <TextBox x:Name="Search" Grid.Row="0" Width="350" Height="30" Margin="25 0 0 0" TextChanged="Search_TextChanged" FontSize="16"/>
            <TextBlock Text="Фильтры" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" FontSize="16"/>
            <ComboBox x:Name="Sort" Grid.Row="0" Width="30" Height="30" SelectionChanged="ComboBox_SelectionChanged">
                <ComboBox.Template>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <Grid>
                                    <Image Source="Images/filter_icon.png" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                    <Path Data="M0,0 L5,0 L2.5,3 Z" Fill="#666666" Stretch="Uniform" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                </Grid>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" Visibility="Hidden"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border BorderThickness="1" Background="White" BorderBrush="#CCCCCC">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>
                <ComboBoxItem Tag="Названию">По названию</ComboBoxItem>
                <ComboBoxItem Tag="Рейтингу">По рейтингу</ComboBoxItem>
            </ComboBox>
        </WrapPanel>


        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border CornerRadius="15" BorderBrush="Gray" BorderThickness="2"  Height="30" Width="100" Margin="0 0 10 0">
                <Button x:Name="Reg" Content="Home" Grid.Row="0" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Click="Reg_Click"/>
            </Border>
        </StackPanel>


        <ListBox x:Name="Films" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="1" MouseDoubleClick="Films_MouseDoubleClick" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="190" Height="250" Margin="10">
                        <StackPanel>
                            <Grid Width="150" Height="200" Margin="0,0,0,10">
                             
                                <Image Source="{Binding IMAGE_PATH}" Stretch="UniformToFill"/>

                                <Border Background="#4CAF50" CornerRadius="3" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" Padding="4,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="★" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RATING_FILM, StringFormat={}{0:F1}}" Foreground="White" FontWeight="Bold" FontSize="11" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FF5722" CornerRadius="3" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5" Padding="4,2">
                                    <TextBlock Text="{Binding id_agerating, Converter={StaticResource MyAgeRatingConverter}}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding NAME_FILM}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>



            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
