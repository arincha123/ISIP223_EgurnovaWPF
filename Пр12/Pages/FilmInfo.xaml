    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0" Margin="20">
            <Image Source="{Binding CurrentFilm.IMAGE_PATH}" Height="295" Stretch="UniformToFill" Margin="0,0,0,20" Width="204"/>

            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <StackPanel>

                    <WrapPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Рейтинг фильма: " Width="106"/>
                        <TextBlock Text="{Binding DataContext.CurrentFilm.RATING_FILM, StringFormat={}{0:F1}}" FontWeight="Bold" Width="65"/>
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Возрастной рейтинг : " Width="106" Margin=" 0 0 10 0"/>
                        <TextBlock Text="{Binding DataContext.CurrentFilm.id_agerating , StringFormat={}{0:F1}}" FontWeight="Bold" Width="65"/>
                    </WrapPanel>

                </StackPanel>


