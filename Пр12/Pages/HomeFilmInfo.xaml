<Page x:Class="Пр12.Pages.HomeFilmInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomeFilmInfo">

    <Page.Resources>
        <local:AgeRatingConverter x:Key="MyAgeRatingConverter"/>
    </Page.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0" Margin="20">
            <Image Source="{Binding CurrentFilm.IMAGE_PATH}" Height="295" Stretch="UniformToFill" Margin="0,0,0,20" Width="204"/>

            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <StackPanel>

                    <WrapPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Рейтинг фильма: " Width="106"/>
                        <TextBlock Text="{Binding DataContext.CurrentFilm.RATING_FILM, StringFormat={}{0:F1}}" FontWeight="Bold" Width="65"/>
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Возрастной рейтинг : " Width="106"/>
                        <TextBlock Text="{Binding DataContext.CurrentFilm.id_agerating , StringFormat={}{0:F1}}" FontWeight="Bold" Width="65"/>
                    </WrapPanel>

                </StackPanel>


                <!--<ListBox x:Name="RatingsList" BorderThickness="0" Background="{x:Null}">
                    <ListBoxItem>
                        <WrapPanel Orientation="Horizontal" Margin="10">
                            <TextBlock Text="Возрастной рейтинг: " Width="130"/>
                            <TextBlock Text="{Binding DataContext.CurrentFilm.id_agerating, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource MyAgeRatingConverter}}" FontWeight="Bold" Width="66"/>
                        </WrapPanel>
                    </ListBoxItem>

                    <ListBoxItem>
                        <WrapPanel Orientation="Horizontal" Margin="10">
                            <TextBlock Text="Рейтинг фильма: " Width="106"/>
                            <TextBlock Text="{Binding DataContext.CurrentFilm.RATING_FILM, StringFormat={}{0:F1}}" FontWeight="Bold" Width="65"/>
                        </WrapPanel>
                    </ListBoxItem>
                </ListBox>-->
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Button Content="← Назад" HorizontalAlignment="Left" Click="BackButton_Click" Margin="0,0,0,20" Width="70"/>

                <TextBlock Text="{Binding CurrentFilm.NAME_FILM}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,1" Padding="0,10">
                    <TextBlock Text="{Binding CurrentFilm.DESCRIPTION}" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                </Border>

                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="Доступные сеансы:" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>


                    <ListBox x:Name="SeansList" ItemsSource="{Binding Seans}"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{x:Null}" MouseDoubleClick="ChooseSeat" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel>
                                    <Border CornerRadius="10" BorderThickness="1" BorderBrush="Black" >
                                        <StackPanel Margin="10">
                                            <TextBlock Text="{Binding HALL.HALL_NAME, StringFormat='\{0}' }" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DATE_SESSION, StringFormat= '\{0: yyyy MM dd}'   }" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DATE_SESSION, StringFormat= '\{0:HH:MM}'   }" HorizontalAlignment="Center"/>
                                            <!--<Button Content="Выбор места" />-->
                                            
                                            
                                        </StackPanel>


                                    </Border>
                                    
                                    
                                </WrapPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                    </ListBox>
          
                    <TextBlock x:Name="NoSessionsText" Text="На данный момент нет доступных сеансов" Foreground="#999" FontStyle="Italic" Visibility="Collapsed" Margin="0,20,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
