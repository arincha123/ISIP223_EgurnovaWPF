<Page x:Class="Пр12.Pages.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage" Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Grid.ColumnSpan="2"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="10">

            <StackPanel>
                <WrapPanel>
                    <TextBlock x:Name="UserName"
                           FontSize="20"
                           Grid.Row="0"
                           Grid.Column="1"
                           Width="auto"
                           HorizontalAlignment="Left"
                           Margin="10 0 20 0"/>

                    <TextBlock x:Name="UserLogin" 
                           FontSize="20"
                           Grid.Row="1"
                           Grid.Column="1"
                           HorizontalAlignment="Left"
                           Margin="10 0 20 0"/>

                    <TextBlock x:Name="UserEamil" 
                           FontSize="20"
                           Grid.Row="2"
                           Grid.Column="1"
                           HorizontalAlignment="Left"
                           Margin="10 0 0 0"/>
                </WrapPanel>

                    <!--<TextBlock Text="Имя"
                           Grid.Row="0"
                           Grid.Column="0"
                           FontSize="16"/>-->
                    <!--<TextBlock Text="Логин"
                           Grid.Row="1"
                           Grid.Column="0"
                           FontSize="16"/>-->
                    <!--<TextBlock Text="Email"
                           Grid.Row="2"
                           Grid.Column="0"
                           FontSize="16"/>-->

                <WrapPanel>
                    
                    <TextBlock Text="Роль"
                            Grid.Row="3"
                            Grid.Column="0"
                            FontSize="20"
                            Margin="10 0 0 0"/>

                    <TextBlock x:Name="UserRole"
                               FontSize="20"
                               Grid.Row="3"
                               Grid.Column="1"
                               HorizontalAlignment="Left"
                               Margin="10 0 0 0"/>

                </WrapPanel>

            </StackPanel>
        </Border>

        <Button x:Name="RegForAuth"
                Grid.Row="1"
                Grid.Column="2"/>
        
        <TextBlock Text="Ваши отзывы"
                   FontSize="20"
                   Grid.Row="1"
                   FontWeight="Bold"
                   Margin="10"/>
        
        <!-- сам список отзывов -->
        <ListBox x:Name="ReviewsListBox"
                Style="{StaticResource ListReviews}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Margin="30 0 30 0"
                Grid.Row="2"
                Grid.ColumnSpan="2">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{Binding User.Name}"
                                            FontWeight="Bold"
                                            FontSize="16"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Rating, StringFormat='Оценка: {0}★'}"
                                            FontSize="14"
                                            Foreground="#FF151286"
                                            VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Date, StringFormat=' - {0:dd.MM.yyyy HH:mm}'}"
                                            FontSize="12"
                                            Foreground="Gray"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"/>

                            </WrapPanel>

                            <TextBlock Text="{Binding Text}"
                            TextWrapping="Wrap"
                            FontSize="16"
                            Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

    </Grid>
</Page>
