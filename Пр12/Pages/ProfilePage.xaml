<Page x:Class="Пр12.Pages.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage" Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#FF151286"
                BorderThickness="2"
                CornerRadius="15"
                Padding="20"
                Margin="0 0 0 15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Имя:"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0 5 10 5"/>
                <TextBlock x:Name="UserName" Grid.Row="0" Grid.Column="1"
                           FontSize="16"
                           Margin="0 5 0 5"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Логин:"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0 5 10 5"/>
                <TextBlock x:Name="UserLogin" Grid.Row="1" Grid.Column="1"
                           FontSize="16"
                           Margin="0 5 0 5"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Email:"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0 5 10 5"/>
                
                <TextBlock x:Name="UserEamil" Grid.Row="2" Grid.Column="1"
                           FontSize="16"
                           Margin="0 5 0 5"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Роль:"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0 5 10 5"/>
                <TextBlock x:Name="UserRole" Grid.Row="3" Grid.Column="1"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0 5 0 5"/>
            </Grid>
        </Border>

        
        <Border Grid.Row="2"
                Background="#FFF5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10"
                Margin="0 0 0 15">

            <WrapPanel HorizontalAlignment="Right">

                <Button x:Name="ReqForUnfroz"
                        Grid.Row="5"
                        Content="Оспорить заморозку"
                        Width="150"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#FF151286"
                        Foreground="White"
                        Cursor="Hand"
                        Margin="0 0 30 0"
                        Visibility="Visible"
                        Click="ReqForUnfroz_Click"/>
                
                <Button x:Name="ReqForAuth"
                        Content="Подать заявку на роль автора"
                        Width="200"
                        Height="35"
                        Background="#FF151286"
                        Foreground="White"
                        Cursor="Hand"
                        Click="ReqForAuth_Click"/>


            </WrapPanel>
        </Border>

        <Border x:Name="FreezeWarningBorder"
                Grid.Row="3"
                Background="#FFF0F0F0"
                BorderBrush="#FF0000"
                BorderThickness="2"
                CornerRadius="10"
                Padding="15"
                Margin="0 0 0 15"
                Visibility="Collapsed">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Margin="0 0 0 10">
                    <TextBlock Text="!!!" FontSize="20"/>
                    <TextBlock Text="Ваш аккаунт заморожен!"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FF0000"/>
                </WrapPanel>

                <TextBlock Grid.Row="1"
                           Text="Причина:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0 0 0 5"/>

                <TextBlock x:Name="AlertIfFrozen"
                           Grid.Row="2"
                           FontSize="14"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0 0 0 10"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="Мои отзывы"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#FF151286"
                   Margin="0 5 0 0"/>

        <ListBox x:Name="ReviewsListBox"
                 Grid.Row="5"
                 Style="{StaticResource ListReviews}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 MaxHeight="300"
                 BorderBrush="#E0E0E0"
                 BorderThickness="1"
                 Margin="0 0 0 15" d:ItemsSource="{d:SampleData ItemCount=5}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{Binding Book.Title}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#FF151286"
                                           Margin="0 0 10 0"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Rating, StringFormat='Оценка: {0}★'}"
                                           FontSize="14"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding Date, StringFormat=' - {0:dd.MM.yyyy}'}"
                                           FontSize="12"
                                           Foreground="Gray"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding Text}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock x:Name="NoReviewsText"
                   Grid.Row="5"
                   Text="У вас пока нет отзывов"
                   FontSize="14"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

    </Grid>
</Page>
