<Page x:Class="Пр12.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="53"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Косметическое что-то" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="10" FontSize="36" />

        <Button Grid.Column="4" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Width="70" Height="27" Margin="30 0 10 0" Content="Вход" x:Name="LogIn" FontSize="16" Click="LogIn_Click"/>
        <StackPanel Orientation="Horizontal" Grid.Column="4" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Width="100" Height="27" Margin="30 0 10 0" Content="Выйти" x:Name="AccountOut" FontSize="16" Click="AccountOut_Click"/>
            <Button Width="100" Height="27" Margin="30 0 10 0" Content="Аккаунт" x:Name="AccountIn" FontSize="16" Click="AccountIn_Click"/>
            
        </StackPanel>


        <WrapPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock  VerticalAlignment="Center" FontSize="18" Margin="10" Text="Мастер:" />
            <ComboBox x:Name="MasterCBox" Width="150" FontSize="16" Height="33" VerticalAlignment="Center"/>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock  VerticalAlignment="Center" FontSize="18" Margin="10" Text="Услуги:"/>
            <ComboBox x:Name="CategoryCBox" Width="150" FontSize="16" VerticalAlignment="Center" Height="33"/>
        </WrapPanel>

        <Button Grid.Column="2" Grid.Row="1" Height="33" Width="170" Content="Применить фильтр" HorizontalAlignment="Left" FontSize="16" Margin="10" Click="Button_Click"/>
        <Button Grid.Column="3" Grid.Row="1" Width="100" Height="33" Margin="10" x:Name="Tovari" Content="Товары" FontSize="16" HorizontalAlignment="Right" Click="Tovari_Click"/>

        <ListBox x:Name="ShowServ" Grid.Row="2" Grid.ColumnSpan="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=7}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="200" Height="120" Margin="10" >
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock FontSize="18" Text="{Binding User.FirstName}" Margin="0 0 5 0"/>
                                <TextBlock FontSize="18" Text="{Binding User.MiddleName}"/>
                            </WrapPanel>
                            <TextBlock FontSize="18" Text="{Binding User.LastName}"/>
                            <TextBlock Margin="0 10 0 10" FontSize="18" HorizontalAlignment="Center" Text="{Binding Service.ServCategory.Name}" FontWeight="Bold"/>
                            <Button FontSize="18" Content="Записаться" Click="Button_Click_1"  />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>