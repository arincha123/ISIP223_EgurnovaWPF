<Page x:Class="Пр12.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="53"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Косметическое что-то" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="10" FontSize="36" />
        
        <WrapPanel Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="70" Height="27" x:Name="Tovari" Content="Товары" FontSize="16"/>
            <Button Width="70" Height="27" Margin="30 0 10 0" Content="Вход" x:Name="LogIn" FontSize="16"/>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock  VerticalAlignment="Center" FontSize="18" Margin="10" Text="Мастер:" />
            <ComboBox x:Name="MasterCBox" Width="150" Height="33"/>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock  VerticalAlignment="Center" FontSize="18" Margin="10" Text="Услуги:"/>
            <ComboBox x:Name="CategoryCBox" Width="150" Height="33"/>
        </WrapPanel>

        <Button Grid.Column="2" Grid.Row="1" Height="33" Width="170" Content="Применить фильтр" HorizontalAlignment="Right" FontSize="16" Margin="10"/>

        <ListBox x:Name="ShowServ" Grid.Row="2" Grid.ColumnSpan="3" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=7}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="120" Height="55" Margin="10" >
                        <StackPanel >
                            <TextBlock Text="Name"/>
                            <TextBlock Text="Category fo Serv"/>
                            <Button Content="Записаться" />

                        </StackPanel>
                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        
        
        
    </Grid>
</Page>
