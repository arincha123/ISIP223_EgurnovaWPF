<Page x:Class="Пр12.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountPage">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Введите свой логин" Width="300" />
            <TextBox x:Name="Login" Margin="0 10 0 0" SelectionChanged="Danni_SelectionChanged"/>
            <TextBlock Text="Введите свой пароль" Width="300" Margin="0 10 0 0"/>
            <TextBox x:Name="Password" Margin="0 10 0 0" SelectionChanged="Danni_SelectionChanged"/>
            <Button x:Name="GoIn" Content="Войти" Width="75" Height="20" Margin="0 30 0 0" Click="GoIn_Click" IsEnabled="False"/>
            <Button x:Name="noReg" Content="Вы не зарегистрированы? Создайте аккаунт" Width="300" Height="20" Margin="0 20 0 0" Background="Transparent" BorderBrush="{x:Null}" Foreground="#FF4472BD" Click="noReg_Click"/>

        </StackPanel>

        <Button x:Name="Back" Content="Назад" Width="100" Height="30" Background="Transparent" BorderBrush="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" Click="Back_Click"/>
    </Grid>
</Page>
