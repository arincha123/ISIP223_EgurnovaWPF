<Page x:Class="Пр12.Pages.MasterPages.ServiceInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages.MasterPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ServiceInfo">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="18" HorizontalAlignment="Center" Text="Название"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" FontSize="18" HorizontalAlignment="Stretch" Text="{Binding Service.Name}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="18" HorizontalAlignment="Center" Text="Категория"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="18" HorizontalAlignment="Stretch" Text="{Binding Service.ServCategory.Name}"/>

        
        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="18" HorizontalAlignment="Center" Text="Дата"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" FontSize="18" HorizontalAlignment="Stretch" Text="{Binding Date, StringFormat='dd.MM.yyyy'}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="18" HorizontalAlignment="Center" Text="Время"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" FontSize="18" HorizontalAlignment="Center">
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} - {1}">
                    <Binding Path="Schedule.Time" StringFormat="hh:mm"/>
                    <Binding Path="Schedule.EndTime" StringFormat="hh:mm"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <TextBlock Grid.Row="4" Grid.Column="0" FontSize="18" HorizontalAlignment="Center" Text="ФИО клиента"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" FontSize="18" HorizontalAlignment="Stretch">
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} {1} {2}">
                    <Binding Path="User.LastName"/>
                    <Binding Path="User.FirstName"/>
                    <Binding Path="User.MiddleNAme"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        
        
        <TextBlock Grid.Row="5" Grid.Column="0" FontSize="18" HorizontalAlignment="Center" Text="Номер телефона"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" FontSize="18" HorizontalAlignment="Stretch" Text="{Binding User.PhoneNumber}"/>


        <Button x:Name="CloseZapis_Btn" Grid.Column="2" Grid.Row="6" Content="Закрыть запись?" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                Width="150" Height="33" Click="CloseZapis_Btn_Click" />

    </Grid>
</Page>
