<Page x:Class="Пр12.Pages.MasterPages.MainMasterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages.MasterPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainMasterPage">

    <Grid>

        <TabControl >
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="18">Записи</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <ListView x:Name="Services" FontSize="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Services_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Услуга" Width="Auto" DisplayMemberBinding="{Binding Service.Name}"/>
                                    <GridViewColumn Header="Дата" Width="Auto" DisplayMemberBinding="{Binding Date, StringFormat='dd.MM.yyyy'}"/>
                                    <GridViewColumn Header="Время начала" Width="Auto" DisplayMemberBinding="{Binding Schedule.Time, StringFormat='HH:mm'}"/>
                                    <GridViewColumn Header="Время окончания" Width="Auto" DisplayMemberBinding="{Binding Schedule.EndTime, StringFormat='HH:mm'}"/>
                                    <GridViewColumn Header="Клиент" Width="Auto" DisplayMemberBinding="{Binding User.LastName}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem.Content>
            </TabItem>
            
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="18">Услуги</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Мои услуги" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Все услуги" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5"/>

                        <ListView x:Name="YourServices" Grid.Row="1" Grid.Column="0" FontSize="14" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="5">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="№" Width="40" DisplayMemberBinding="{Binding ID}"/>
                                    <GridViewColumn Header="Услуга" Width="180" DisplayMemberBinding="{Binding Service.Name}"/>
                                    <GridViewColumn Header="Цена" Width="80" DisplayMemberBinding="{Binding Price, StringFormat=C}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <ListView x:Name="AllServicesList" Grid.Row="1" Grid.Column="1" FontSize="14" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="5">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="№" Width="40" DisplayMemberBinding="{Binding ID}"/>
                                    <GridViewColumn Header="Услуга" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Категория" Width="120" DisplayMemberBinding="{Binding ServCategory.Name}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                            <TextBlock Text="Введите название из правого списка" FontSize="14" Margin="0,10,0,5"/>
                            <TextBox x:Name="AddServ" Width="180" Height="30" Margin="0,5"/>
                            <Button x:Name="AddServ_Btn" Content="Добавить по названию" Width="180" Height="35" 
                        Margin="0,10" Click="AddServ_Btn_Click"/>

                            <TextBlock Text="Удалить по ID" HorizontalAlignment="Center" FontSize="14" Margin="0,10,0,5"/>
                            <TextBox x:Name="DelServ" Width="180" Height="30" Margin="0,5"/>
                            <Button x:Name="DelServ_Btn" Content="Удалить по ID" Width="180" Height="35" 
                        Margin="0,10" Click="DelServ_Btn_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem.Content>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
