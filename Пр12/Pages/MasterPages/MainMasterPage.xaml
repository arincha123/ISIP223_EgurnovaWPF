<Page x:Class="Пр12.Pages.MasterPages.MainMasterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages.MasterPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainMasterPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10" FontSize="18"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Фамилия" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10" FontSize="18"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Отчество" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10" FontSize="18"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Роль" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10" FontSize="18"/>

        <TabControl Grid.Row="1" Grid.ColumnSpan="4">
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="18">Записи</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <ListView x:Name="Services" FontSize="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Services_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Услуга" Width="Auto" DisplayMemberBinding="{Binding Service.Name}"/>
                                    <GridViewColumn Header="Дата" Width="Auto" DisplayMemberBinding="{Binding Date, StringFormat='dd.MM.yyyy'}"/>
                                    <GridViewColumn Header="Время начала" Width="Auto" DisplayMemberBinding="{Binding Schedule.Time, StringFormat='HH:mm'}"/>
                                    <GridViewColumn Header="Время окончания" Width="Auto" DisplayMemberBinding="{Binding Schedule.EndTime, StringFormat='HH:mm'}"/>
                                    <GridViewColumn Header="Клиент" Width="Auto" DisplayMemberBinding="{Binding User.LastName}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem.Content>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="18">Услуги</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <ListView x:Name="YourServices" FontSize="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Услуга" Width="Auto" DisplayMemberBinding="{Binding Service.Name}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="16">Введите название услуги</TextBlock>
                            <TextBox x:Name="AddServ" Width="200" Height="25" Margin="0 10 0 10"/>
                            <Button x:Name="AddServ_Btn" FontSize="14" Height="25" Width="120" Content="Добавить услугу" Margin="0 0 0 30" Click="AddServ_Btn_Click"/>

                            <TextBlock FontSize="16">Выберите название услуги</TextBlock>
                            <ComboBox x:Name="ServForDel" Width="200" Margin="0 10 0 10" />
                            <Button x:Name="DelServ_Btn" FontSize="14" Height="25" Width="120" Content="Удалить услугy" Click="DelServ_Btn_Click"/>
                        </StackPanel>
                        
                    </Grid>
                </TabItem.Content>
            </TabItem>
        </TabControl>
        
        
    </Grid>
</Page>
