<Page x:Class="Пр12.Pages.TypeInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TypeInfo">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="NameOfPart" Grid.Row="0" Text="{Binding name}" FontSize="20" VerticalAlignment="Center" FontFamily="Segoe UI Historic" HorizontalAlignment="Left" Margin="20 0 0 0" FontWeight="Bold"  />

        <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1" >
            <TextBox x:Name="Search" Grid.Row="0" Width="350" Height="30" Margin="25 0 0 0" TextChanged="Search_TextChanged" FontSize="16"/>
            <TextBlock Text="Фильтры" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" FontSize="16"/>
            <ComboBox x:Name="ComboFiltr" Grid.Row="0" Height="30" SelectionChanged="ComboBox_SelectionChanged" SelectedIndex="0" FontSize="16"/>
        </WrapPanel>


        <ListBox x:Name="Selectedparts" Grid.Row="2" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Image Source="{Binding image}" Width="170" Grid.Column="0" Grid.RowSpan="2"/>
                        <TextBlock Text="{Binding name}" FontSize="20" Grid.Column="1"  />
                        <TextBlock Text="{Binding FullDescription, StringFormat=[{0}]}" FontSize="20" Grid.Column="1" Grid.Row="1" />
                        <TextBlock Text="{Binding price, StringFormat={}{0:N0} ₽}" Grid.Column="2" FontSize="20" HorizontalAlignment="Right" />
                        <Button x:Name="AddInAssemb" Content="Добавить" FontSize="16" Grid.Row="1" Grid.Column="2" Width="80" Height="30" Background="#2196F3" 
                                    Foreground="White" BorderThickness="0" VerticalAlignment="Top" Click="AddInAssemb_Click" />
                    </Grid>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="Назад" Grid.Row="2" Width="70" Height="30" Background="#2196F3" 
        Foreground="White" BorderThickness="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" 
                FontSize="16" Click="Button_Click"/>





    </Grid>
</Page>
