<Page x:Class="Пр12.Pages.TypeInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TypeInfo">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="NameOfPart" Grid.Row="0" Text="{Binding name}" FontSize="20" VerticalAlignment="Center" FontFamily="Segoe UI Historic" HorizontalAlignment="Left" Margin="20 0 0 0" FontWeight="Bold"  />

        <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1" >
            <TextBox x:Name="Search" Grid.Row="0" Width="350" Height="30" Margin="25 0 0 0" TextChanged="Search_TextChanged" FontSize="16"/>
            <TextBlock Text="Фильтры" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" FontSize="16"/>
            <ComboBox x:Name="ComboFiltr" Grid.Row="0" Height="30" SelectionChanged="ComboBox_SelectionChanged" SelectedIndex="0" FontSize="18"/>
            <ListBox x:Name="Selectedparts" >
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                       
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>




        </WrapPanel>

    </Grid>
</Page>
