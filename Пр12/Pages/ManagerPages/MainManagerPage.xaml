<Page x:Class="Пр12.Pages.ManagerPages.MainManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages.ManagerPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainManagerPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <TabControl Grid.Row="1" Grid.ColumnSpan="4" >
            <TabItem>
                <TabItem.Header>
                    <TextBlock>Услуги</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                    
                        <ListView x:Name="ServCList" Grid.Column="0" Grid.RowSpan="2" FontSize="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="ServСList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="№" Width="Auto" DisplayMemberBinding="{Binding ID}"/>
                                    <GridViewColumn Header="Все типы услуг" Width="Auto" DisplayMemberBinding="{Binding Name}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="16" Text="Название нового типа услуги"/>
                            <TextBox x:Name="AddServType" FontSize="16" Width="150" Height="25" Margin="0 10 0 10"/>
                            <Button x:Name="AddST_Btn" Content="Добавить тип" Width="150" Height="25" Click="AddST_Btn_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="16" Text="Напишите № типа услуг, который хотите удалить"/>
                            <TextBox x:Name="DelServType" FontSize="16" Width="150" Height="25" Margin="0 10 0 10"/>
                            <Button x:Name="DeleteST_Btn" Content="Удалить тип" Width="150" Height="25" Click="DeleteST_Btn_Click"/>
                        </StackPanel>

                    </Grid>
                </TabItem.Content>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock>Записи</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListView x:Name="ZapisiList" Grid.Column="0" Grid.RowSpan="3" FontSize="14" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Клиент" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                                            <Binding Path="User.LastName"/>
                                                            <Binding Path="User.FirstName"/>
                                                            <Binding Path="User.MiddleName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Телефон" Width="100" DisplayMemberBinding="{Binding User.PhoneNumber}"/>
                                    <GridViewColumn Header="Услуга" Width="150" DisplayMemberBinding="{Binding Service.Name}"/>
                                    <GridViewColumn Header="Дата" Width="80" DisplayMemberBinding="{Binding Date, StringFormat=dd.MM.yyyy}"/>
                                    <GridViewColumn Header="Время" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:HH:mm} - {1:HH:mm}">
                                                            <Binding Path="Schedule.Time"/>
                                                            <Binding Path="Schedule.EndTime"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Мастер" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}">
                                                            <Binding Path="Master.LastName"/>
                                                            <Binding Path="Master.FirstName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="10">
                            <TextBlock FontSize="16" Text="Поиск клиента" FontWeight="Bold"/>
                            <TextBox x:Name="SearchClientBox" FontSize="14" Height="30" Margin="0,5,0,5"/>
                            <ListBox x:Name="SearchResultsList" Height="150" FontSize="14" SelectionChanged="SearchResultsList_SelectionChanged" d:ItemsSource="{d:SampleData ItemCount=5}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullNameWithPhone}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="10">
                            <TextBlock FontSize="16" Text="Действия с записью" FontWeight="Bold" Margin="0,0,0,10"/>

                            <TextBlock Text="Выберите услугу"/>
                            <ComboBox x:Name="NewServiceCombo" FontSize="14" Height="30" Margin="0,5,0,10"/>

                            <TextBlock Text="Выберите дату"/>
                            <DatePicker x:Name="NewDatePicker" FontSize="14" Height="30" Margin="0,5,0,10"/>

                            <TextBlock Text="Выберите время"/>
                            <ComboBox x:Name="NewTimeCombo" FontSize="14" Height="30" Margin="0,5,0,10"/>

                            <TextBlock Text="Выберите мастера"/>
                            <ComboBox x:Name="NewMasterCombo" FontSize="14" Height="30" Margin="0,5,0,15"/>

                            <Button x:Name="AddRecordBtn" Content="Записать клиента" Width="150" Height="35" 
                            Click="AddRecordBtn_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="2" Margin="10">
                            <Button x:Name="CancelRecordBtn" Content="Отменить запись" Width="150" Height="35" 
                            Margin="0,0,0,10" Click="CancelRecordBtn_Click"/>
                            <Button x:Name="RescheduleBtn" Content="Перенести запись" Width="150" Height="35" 
                            Click="RescheduleBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem.Content>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock>Заказы</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListView x:Name="OrdersList" Grid.Column="0" FontSize="14" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=10}" SelectionChanged="OrdersList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="№ заказа" Width="80" DisplayMemberBinding="{Binding ID}"/>
                                    <GridViewColumn Header="Сумма" Width="80" DisplayMemberBinding="{Binding TotalAmount, StringFormat=C}"/>
                                    <GridViewColumn Header="Дата" Width="80" DisplayMemberBinding="{Binding Date, StringFormat=dd.MM.yyyy}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Выделите заказ и нажмите" FontSize="14" Margin="0,0,0,10"/>
                            <Button x:Name="CloseOrderBtn" Content="Закрыть заказ (выдача)" Width="180" Height="40" 
                            Click="CloseOrderBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem.Content>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock>Товары</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListView x:Name="ProductsList" Grid.Column="0" Grid.RowSpan="4" FontSize="14" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="ProductsList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Товар" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Цена" Width="80" DisplayMemberBinding="{Binding Cost, StringFormat=C}"/>
                                    <GridViewColumn Header="Производитель" Width="100" DisplayMemberBinding="{Binding Manufacturer.Name}"/>
                                    <GridViewColumn Header="Тип" Width="100" DisplayMemberBinding="{Binding ProdCategory.Name}"/>
                                    <GridViewColumn Header="Скидка" Width="60" DisplayMemberBinding="{Binding Discount, StringFormat={}{0}%}"/>
                                    <GridViewColumn Header="Статус" Width="60" DisplayMemberBinding="{Binding StatusText}"/>
                            
                                    <!--<GridViewColumn Header="Статус" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="Активен" Foreground="Green">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                                    <Setter Property="Text" Value="Заморожен"/>
                                                                    <Setter Property="Foreground" Value="Red"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>-->
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="10">
                            <TextBlock FontSize="16" Text="Название товара" FontWeight="Bold"/>
                            <TextBox x:Name="ProductNameBox" FontSize="14" Height="30" Margin="0,5,0,10"/>

                            <TextBlock Text="Цена"/>
                            <TextBox x:Name="ProductPriceBox" FontSize="14" Height="30" Margin="0,5,0,10"/>

                            <TextBlock Text="Производитель"/>
                            <ComboBox x:Name="ProductManufacturerCombo" FontSize="14" Height="30" Margin="0,5,0,10"/>

                            <TextBlock Text="Тип товара"/>
                            <ComboBox x:Name="ProductTypeCombo" FontSize="14" Height="30" Margin="0,5,0,15"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="AddProductBtn" Content="Добавить" Width="80" Height="30" Margin="5" Click="AddProductBtn_Click"/>
                            <Button x:Name="EditProductBtn" Content="Изменить" Width="80" Height="30" Margin="5" Click="EditProductBtn_Click"/>
                            <Button x:Name="DelProductBtn" Content="Удалить" Width="80" Height="30" Margin="5" Click="DelProductBtn_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="2" Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="FreezeProductBtn" Content="Заморозить" Width="80" Height="30" Margin="5" Click="FreezeProductBtn_Click"/>
                            <Button x:Name="UnfreezeProductBtn" Content="Разморозить" Width="80" Height="30" Margin="5" Click="UnfreezeProductBtn_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="3" Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Скидка (%):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="ProductDiscountBox" Text="0" Width="60" Height="25" FontSize="16" VerticalAlignment="Center"/>
                            <Button x:Name="ApplyDiscountBtn" Content="Применить" Width="80" Height="30" Margin="5" Click="ApplyDiscountBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem.Content>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock>Типы товаров</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <ListView x:Name="ProductTypesList" Grid.Column="0" Grid.RowSpan="2" FontSize="16" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="№" Width="Auto" DisplayMemberBinding="{Binding ID}"/>
                                    <GridViewColumn Header="Тип товара" Width="Auto" DisplayMemberBinding="{Binding Name}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="16" Text="Название нового типа товара"/>
                            <TextBox x:Name="AddProductTypeBox" FontSize="16" Width="150" Height="25" Margin="0 10 0 10"/>
                            <Button x:Name="AddProductTypeBtn" Content="Добавить тип" Width="150" Height="25" Click="AddProductTypeBtn_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="16" Text="Напишите № типа товара, который хотите удалить"/>
                            <TextBox x:Name="DelProductTypeBox" FontSize="16" Width="150" Height="25" Margin="0 10 0 10"/>
                            <Button x:Name="DelProductTypeBtn" Content="Удалить тип" Width="150" Height="25" Click="DelProductTypeBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem.Content>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock>Производители</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138*"/>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="159*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <ListView x:Name="ManufacturersList" Grid.Column="0" Grid.RowSpan="2" FontSize="16" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="2">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="№" Width="Auto" DisplayMemberBinding="{Binding ID}"/>
                                    <GridViewColumn Header="Производитель" Width="Auto" DisplayMemberBinding="{Binding Name}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="16" Text="Название производителя"/>
                            <TextBox x:Name="AddManufacturerNameBox" FontSize="16" Width="150" Height="25" Margin="0 10 0 10"/>
                            <Button x:Name="AddManufacturerBtn" Content="Добавить" Width="150" Height="25" Click="AddManufacturerBtn_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="16" Text="Напишите № производителя, чтобы удалить"/>
                            <TextBox x:Name="DelManufacturerNameBox" FontSize="16" Width="150" Height="25" Margin="0 10 0 10"/>
                            <Button x:Name="DelManufacturerBtn" Content="Удалить" Width="150" Height="25" Click="DelManufacturerBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem.Content>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
