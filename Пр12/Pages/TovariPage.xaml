            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top">
                <TextBlock Text="⌕" FontSize="16" Margin="10"/>
                <TextBox x:Name="TxtBoxSearch" Width="150" Height="27" FontSize="20" TextChanged="TxtBoxSearch_TextChanged"/>

                <ComboBox x:Name="ComboBoxFiltrProdCat" Height="27" Width="100" Margin="10 0 0 0" SelectedIndex="0" SelectionChanged="ComboBoxFiltrProdCat_SelectionChanged"/>
                <ComboBox x:Name="ComboBoxFiltrProdMan" Height="27" Width="100" Margin="10 0 0 0" SelectedIndex="0" SelectionChanged="ComboBoxFiltrProdCat_SelectionChanged"/>
                <Button x:Name="BtnSortRating" Content="Сортировка по рейтингу" Background="White" Foreground="Black" FontSize="16" Height="27" Margin="10 0 0 0" Click="BtnSortRating_Click"/>
            </WrapPanel>



        <ListBox x:Name="ListBoxProducts" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" MouseDoubleClick="ListBoxProducts_MouseDoubleClick" SelectionChanged="ListBoxProducts_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <StackPanel HorizontalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding Image}" Width="150"  Height="150"/>
                                    <TextBlock Text="{Binding Rating}" HorizontalAlignment="Right"  FontSize="18" />
                                    <Border Visibility="{Binding DiscountVisibility}"  Background="#FF469C5B" Width="39" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}" HorizontalAlignment="Left" FontSize="18"/>
                                </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}"/>
                                <WrapPanel>
                                    <TextBlock Text="{Binding PriceWithDiscount, StringFormat={}{0:F2} P}" Margin="0 0 10 0" />
                                    <TextBlock Visibility="{Binding DiscountVisibility}" Text="{Binding Cost, StringFormat={}{0} P}" TextDecorations="StrikeThrough" Foreground="Gray"/>
                                </WrapPanel>
                                <Button x:Name="BtnAddCart" Content="Добавить в корзину" Click="BtnAddCart_Click"/>

                            </StackPanel>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDiscountMore15}" Value="true">
                                            <Setter Property="Background" Value="LightGreen"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>


                            </Border.Style>
                        </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel></WrapPanel>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>


        <Button x:Name="BtnCart" Content="Корзина" Grid.Row="1" Height="33" Width="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="BtnCart_Click"/>
    </Grid>
</Page>
