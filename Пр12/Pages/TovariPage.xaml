<Page x:Class="Пр12.Pages.TovariPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TovariPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="CartIn" FontSize="16" Width="70" Height="33" HorizontalAlignment="Right" Margin="0 0 10 0" Grid.Row="0" Content="Корзина" />
        <WrapPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Text="Поиск: " FontSize="16"/>
            <TextBox x:Name="Search" Margin="10 0 0 0" Width="250" />
        </WrapPanel>

        <WrapPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ComboBox x:Name="TypeComBox" Width="150" Margin="0 0 50 0" />
            <ComboBox x:Name="ManufComBox" Width="150" Margin="10 0 10 0"/>
            <ComboBox x:Name="SortComBox" Width="150" Margin="50 0 0 0"/>
        </WrapPanel>

        <ListBox x:Name="TovariList" Grid.Row="3">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel/>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            
            
            
        </ListBox>


    </Grid>
</Page>
