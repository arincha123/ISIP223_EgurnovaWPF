<Page x:Class="Пр12.Pages.AdminPages.MainAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages.AdminPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainAdminPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <TextBlock Grid.Row="0" Text="Логин" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10" FontSize="18"/>
        <TabControl Grid.Row="1" >
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="18">Добавить</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" >
                            <WrapPanel Margin="10" >
                                <TextBlock Text="Имя:" FontSize="18" Margin="40 0 0 0" />
                                <TextBox x:Name="FirstName" Width="150" Margin="10 0 0 0" />
                            </WrapPanel>
                            <WrapPanel Margin="10" >
                                <TextBlock Text="Фамилия:" FontSize="18" />
                                <TextBox x:Name="LastName" Width="150" Margin="10 0 0 0" />
                            </WrapPanel>
                            <WrapPanel Margin="10" >
                                <TextBlock Text="Отчество:" FontSize="18" />
                                <TextBox x:Name="MiddleName" Width="150" Margin="10 0 0 0" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <WrapPanel Margin="10" >
                                <TextBlock Text="Логин (номер телефона):" FontSize="18" />
                                <TextBox x:Name="Login" Width="150" Margin="10 0 0 0" />
                            </WrapPanel>
                            <WrapPanel Margin="10" >
                                <TextBlock Text="Пароль:" FontSize="18" Margin="0 0 140 0"/>
                                <TextBox x:Name="Password" Width="150" Margin="10 0 0 0" />
                            </WrapPanel>
                        </StackPanel>

                        <GroupBox Grid.Column="1" Grid.Row="0" Header="Роли" FontSize="18" >
                            <RadioButton />
                            <RadioButton/>
                            <RadioButton/>
                            <RadioButton/>
                        </GroupBox>
 
                        
                        
                        
                    </Grid>
                </TabItem.Content>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="18">Удалить</TextBlock>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="18">Изменить</TextBlock>
                </TabItem.Header>
            </TabItem>



        </TabControl>

    </Grid>
</Page>
