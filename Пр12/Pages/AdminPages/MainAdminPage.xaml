<Page x:Class="Пр12.Pages.AdminPages.MainAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Пр12.Pages.AdminPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainAdminPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10" FontSize="18"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Фамилия" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10" FontSize="18"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Отчество" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10" FontSize="18"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Роль" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10" FontSize="18"/>

        <TabControl Grid.Row="1" Grid.ColumnSpan="4" >
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="18">Добавить</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center" Grid.Column="0" HorizontalAlignment="Center"  >
                            <WrapPanel Margin="10" >
                                <TextBlock Text="Имя:" FontSize="18" Margin="40 0 0 0" />
                                <TextBox x:Name="FirstName1" Width="150" Margin="10 0 0 0" />
                            </WrapPanel>
                            <WrapPanel Margin="10" >
                                <TextBlock Text="Фамилия:" FontSize="18" />
                                <TextBox x:Name="LastName1" Width="150" Margin="10 0 0 0" />
                            </WrapPanel>
                            <WrapPanel Margin="10" >
                                <TextBlock Text="Отчество:" FontSize="18" />
                                <TextBox x:Name="MiddleName1" Width="150" Margin="10 0 0 0" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" >
                            <WrapPanel Margin="10" >
                                <TextBlock Text="Логин (номер телефона):" FontSize="18" />
                                <TextBox x:Name="Login1" Width="150" Margin="10 0 0 0" />
                            </WrapPanel>
                            <WrapPanel Margin="10" >
                                <TextBlock Text="Пароль:" FontSize="18" Margin="0 0 140 0"/>
                                <TextBox x:Name="Password1" Width="150" Margin="10 0 0 0" />
                            </WrapPanel>
                        </StackPanel>

                        <GroupBox Grid.Column="1" Grid.Row="0" Header="Роль:" FontSize="18" >
                            <StackPanel Margin="10">
                                <RadioButton Margin="5" x:Name="Client1" Content="Клиент"/>
                                <RadioButton Margin="5" x:Name="Master1" Content="Мастер" />
                                <RadioButton Margin="5" x:Name="Manager1" Content="Менеджер" />
                                <RadioButton Margin="5" x:Name="Admin1" Content="Администатор" />
                            </StackPanel>
                        </GroupBox>

                        <Button x:Name="AddBtn" Grid.Column="1" Grid.Row="1" FontSize="18" Content="Добавить пользователя" Click="AddBtn_Click" Width="250" Height="37"/>
                    </Grid>
                </TabItem.Content>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="18">Удалить</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="Clients1"  Grid.Column="0" FontSize="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Клиент" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                                            <Binding Path="LastName"/>
                                                            <Binding Path="FirstName"/>
                                                            <Binding Path="MiddleName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Телефон" Width="100" DisplayMemberBinding="{Binding PhoneNumber}"/>
                                    <GridViewColumn Header="Роль" Width="100" DisplayMemberBinding="{Binding Role.Name}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>


                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Введите телефон пользователя, которого хотите удалить: " FontSize="18" TextWrapping="WrapWithOverflow" />

                            <WrapPanel Margin="10 10 10 20">
                                <TextBlock Text="Номер телефона (логин)" FontSize="14"/>
                                <TextBox x:Name="Phone2" Width="150" Margin="10 0 0 0"/>
                            </WrapPanel>

                            <Button x:Name="DelPol" Content="Удалить пользователя" Width="180" FontSize="16" Click="DelPol_Click" />
                        </StackPanel>

                    </Grid>
                </TabItem.Content>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="18">Изменить</TextBlock>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListView x:Name="Clients2"  Grid.Column="0" FontSize="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Клиент" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                                            <Binding Path="LastName"/>
                                                            <Binding Path="FirstName"/>
                                                            <Binding Path="MiddleName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Телефон" Width="100" DisplayMemberBinding="{Binding PhoneNumber}"/>
                                    <GridViewColumn Header="Роль" Width="100" DisplayMemberBinding="{Binding Role.Name}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Введите телефон пользователя, роль которого хотите изменить: " FontSize="18" TextWrapping="WrapWithOverflow" />
                            <WrapPanel Margin="10 10 10 20">
                                <TextBlock Text="Номер телефона (логин)" FontSize="14"/>
                                <TextBox x:Name="Phone3" Width="150" Margin="10 0 0 0"/>
                            </WrapPanel>
                            <GroupBox Grid.Column="1" Grid.Row="0" Header="Роль:" FontSize="18" >
                                <StackPanel Margin="10">
                                    <RadioButton Margin="5" x:Name="Client3" Content="Клиент"/>
                                    <RadioButton Margin="5" x:Name="Master3" Content="Мастер" />
                                    <RadioButton Margin="5" x:Name="Manager3" Content="Менеджер" />
                                    <RadioButton Margin="5" x:Name="Admin3" Content="Администатор" />
                                </StackPanel>
                            </GroupBox>
                            <Button x:Name="ChangePol" Content="Изменить роль" Width="140" FontSize="16" Margin="10" Click="ChangePol_Click" />
                        </StackPanel>
                    </Grid>
                </TabItem.Content>
            </TabItem>
        </TabControl>

    </Grid>
</Page>
