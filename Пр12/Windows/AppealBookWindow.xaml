<Window x:Class="Пр12.Windows.AppealBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Пр12.Windows"
        mc:Ignorable="d"
        Title="AppealBookWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="1"
                   Text="Оспаривание заморозки книги"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#FF151286"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2"
                   Text="Укажите причину, по которой вы считаете, что книга должна быть разморожена:"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

        <TextBox x:Name="ReasonTextBox"
                 Grid.Row="3"
                 Height="120"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 BorderBrush="#E0E0E0"
                 BorderThickness="1"
                 Padding="10"
                 FontSize="13"/>

        <WrapPanel Grid.Row="4"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0">
            <Button Content="Отмена"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="CancelBtn_Click"/>
            <Button Content="Отправить заявку"
                    Width="150"
                    Height="35"
                    Background="#FF151286"
                    Foreground="White"
                    Click="SubmitBtn_Click"/>
        </WrapPanel>
    </Grid>
</Window>
