    <Style TargetType="Grid">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF84C8EC"/>
                    <GradientStop Color="#FF4966D8" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
